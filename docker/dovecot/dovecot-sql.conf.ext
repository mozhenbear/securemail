driver = mysql
connect = host=db dbname=securemail user=securemail password=securemail99

# Default password scheme (Supports standard $1$ MD5-CRYPT, $2a$/$2b$ BCRYPT, $5$/$6$ SHA-CRYPT)
default_pass_scheme = CRYPT

# Password query for authentication (verifies secure crypt hashes in md5password)
password_query = SELECT mail_address AS user, md5password AS password, 5000 AS userdb_uid, 5000 AS userdb_gid, concat('/var/mail/vhosts/', mail_address) AS userdb_home, concat('maildir:/var/mail/vhosts/', mail_address) AS userdb_mail, concat('*:storage=', quota, 'M') AS userdb_quota_rule FROM mail_account WHERE (mail_address = '%u' OR short_name = '%u') AND active = 1

# User query for mailbox lookup (home MUST be an absolute path without maildir: prefix)
user_query = SELECT concat('/var/mail/vhosts/', mail_address) AS home, concat('maildir:/var/mail/vhosts/', mail_address) AS mail, 5000 AS uid, 5000 AS gid, concat('*:storage=', quota, 'M') AS quota_rule FROM mail_account WHERE (mail_address = '%u' OR short_name = '%u') AND active = 1

# Iterate all valid users
iterate_query = SELECT mail_address AS user FROM mail_account WHERE active = 1
